<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- QA13: devDebug only. Cleartext HTTP to the local Firebase emulators (Auth, Functions)
         on the host machine; every other domain keeps the main manifest's
         usesCleartextTraffic="false". prod and release variants never get this file. -->
    <application android:networkSecurityConfig="@xml/network_security_config_emulators" />
</manifest>
