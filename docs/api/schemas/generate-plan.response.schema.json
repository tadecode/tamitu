{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tamitu/generate-plan.response.v1",
  "title": "generatePlan response (v1) - sketch; full server-side validation schema (NOT sent to Vertex as-is, see $comment)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "requestId", "language", "promptVersion", "days", "quota"],
  "properties": {
    "apiVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "language": { "enum": ["pl", "en"] },
    "promptVersion": { "type": "string", "maxLength": 20 },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayNumber", "title", "items"],
        "properties": {
          "dayNumber": { "type": "integer", "minimum": 1, "maximum": 14 },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "items": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startTime", "name", "locality", "description"],
              "properties": {
                "startTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                "locality": { "type": "string", "minLength": 1, "maxLength": 80 },
                "description": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "remainingToday", "resetAt"],
      "properties": {
        "limit": { "type": "integer", "minimum": 0 },
        "remainingToday": { "type": "integer", "minimum": 0 },
        "resetAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$comment": "Model returns only language, days (and optionally nothing else); server adds apiVersion, requestId, promptVersion, quota. Semantic checks (day count, items per pace, day-1 time floor, language, no URLs) are performed in code, not by this schema. Vertex rejects (HTTP 400) a responseSchema that combines minItems/maxItems on days with maxItems on days[].items (ARCH-01, 2026-11-21); the schema sent to the model is a reduced subset without nested item limits - see docs/architecture/p3-05-wymagania-generowania.md section 3."
}
